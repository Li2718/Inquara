{
  "name": "inquara",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:infra:up": "node scripts/dev.mjs infra-up",
    "dev:infra:down": "node scripts/dev.mjs infra-down",
    "dev:start": "node scripts/dev.mjs start",
    "dev:stop": "node scripts/dev.mjs stop",
    "worktree:create": "node scripts/worktree.mjs create",
    "worktree:clonedb": "node scripts/worktree.mjs clonedb",
    "worktree:cloneinfra": "node scripts/worktree.mjs cloneinfra",
    "worktree:remove": "node scripts/worktree.mjs remove",
    "dev:api": "node scripts/run-workspace.mjs @inquara/api dev",
    "dev:web": "node scripts/run-workspace.mjs @inquara/web dev",
    "prod:up": "docker compose up --build -d",
    "prod:down": "docker compose down",
    "prod:logs": "docker compose logs -f proxy web api migrate",
    "build": "npm run build --workspaces",
    "lint": "eslint . --cache --cache-location ./.cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-location ./.cache/eslint/",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:debug-free": "node scripts/verify-debug-free.mjs",
    "db:generate": "node scripts/run-workspace.mjs @inquara/db generate",
    "db:migrate": "node scripts/run-workspace.mjs @inquara/db migrate",
    "db:migrate:deploy": "node scripts/run-workspace.mjs @inquara/db migrate:deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "dotenv": "^16.6.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "pg": "^8.21.0",
    "testcontainers": "^12.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.0.0"
  }
}
