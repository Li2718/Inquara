{
  "name": "inquara",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file=.env scripts/dev.mjs",
    "dev:api": "node --env-file=.env scripts/run-workspace.mjs @inquara/api dev",
    "dev:web": "node --env-file=.env scripts/run-workspace.mjs @inquara/web dev",
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:debug-free": "node scripts/verify-debug-free.mjs",
    "db:generate": "npm --workspace @inquara/db run generate",
    "db:migrate": "npm --workspace @inquara/db run migrate",
    "db:seed": "npm --workspace @inquara/db run seed"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "npm-run-all": "^4.1.5",
    "pg": "^8.21.0",
    "testcontainers": "^12.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
