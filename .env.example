# Production / Dokploy deployment environment.
#
# Local development uses .env.dev.example instead.

SESSION_SECRET="replace-with-at-least-32-random-characters"
POSTGRES_PASSWORD="replace-with-a-strong-database-password"
WEB_ORIGIN="https://your-inquara-domain.example"

# Optional: set to a fixed host port for standalone Docker Compose usage.
# Leave unset in Dokploy unless you also want Docker to publish a host port.
# WEB_PORT="3000"

AI_PROVIDER="fake"
