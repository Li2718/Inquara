# Local development database URL used by npm run dev and Prisma commands.
DATABASE_URL="postgresql://inquara:inquara@localhost:55432/inquara?schema=public"

# Required by both local development and production.
SESSION_SECRET="replace-with-at-least-32-random-characters"
WEB_ORIGIN="http://localhost:3000"

# Required by production docker-compose.yml. Replace this in real deployments.
POSTGRES_PASSWORD="inquara"

# Optional: set to a fixed host port for standalone Docker Compose usage.
# Leave unset in Dokploy unless you also want Docker to publish a host port.
# WEB_PORT="3000"

# Optional AI provider settings.
AI_PROVIDER="fake"
# OPENAI_COMPATIBLE_BASE_URL=""
# OPENAI_COMPATIBLE_API_KEY=""
# OPENAI_COMPATIBLE_MODEL=""
